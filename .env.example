# BizMuzik — environment template. Copy to .env.local for development.
# Production: runtime values live in the Lockbox secret (every key is mounted as
# an env var by .github/workflows/deploy.yml); NEXT_PUBLIC_* are GitHub Variables.

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_ENABLE_PHONE_VERIFICATION="false"
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=""
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=""

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signs session cookies and one-time tokens. 32+ random chars: openssl rand -base64 48
AUTH_SECRET=""
# Protects /api/cron/* (Bearer token sent by the YC timer trigger)
CRON_SECRET=""
# Salt for hashing IPs in track download events
DOWNLOAD_EVENT_HASH_SALT=""
# Optional; falls back to AUTH_SECRET
BRAND_VOICE_UPLOAD_SECRET=""

# ── Yandex Managed PostgreSQL ────────────────────────────────────────────────
# Port 6432 (Odyssey). TLS + Yandex CA are configured in code (src/db/ssl.ts);
# any sslmode in the URL is ignored. Local dev: a plain local Postgres URL.
DATABASE_URL="postgresql://bizmuzik:PASSWORD@c-CLUSTER_ID.rw.mdb.yandexcloud.net:6432/bizmuzik"
# Optional override for drizzle-kit
DRIZZLE_DATABASE_URL=""

# ── Yandex Object Storage (private bucket) ───────────────────────────────────
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_REGION="ru-central1"
S3_BUCKET="bizmuzik"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Email: UniSender Go (outbound). Inbound replies: Mailgun routes on mg.bizmuzik.ru
UNISENDER_GO_API_KEY=""
# Use go2.unisender.ru if your account lives there
UNISENDER_GO_API_URL="https://go1.unisender.ru/ru/transactional/api/v1/email/send.json"
EMAIL_FROM="Бизмюзик <noreply@bizmuzik.ru>"
# Shared secret in the Mailgun route URL (?secret=...)
INBOUND_EMAIL_SECRET=""

# ── Payments: T-Bank ─────────────────────────────────────────────────────────
TBANK_TERMINAL_KEY=""
TBANK_PASSWORD=""
TBANK_TEST_MODE="true"

# ── AI: DeepSeek (no customer PII in prompts) ────────────────────────────────
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"

# ── Text-to-speech ───────────────────────────────────────────────────────────
SALUTE_SPEECH_CLIENT_ID=""
SALUTE_SPEECH_CLIENT_SECRET=""
GOOGLE_PROJECT_ID=""
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# ── Phone verification: uCaller ──────────────────────────────────────────────
UCALLER_API_KEY=""
UCALLER_SERVICE_ID=""

# ── Support chat: Telegram / Bitrix24 ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_SUPPORT_CHAT_ID=""
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_SUPPORT_TOPIC_ID_GENERAL=""
TELEGRAM_SUPPORT_TOPIC_ID_TECHNICAL=""
TELEGRAM_SUPPORT_TOPIC_ID_BILLING=""
TELEGRAM_SUPPORT_TOPIC_ID_LEGAL=""
BITRIX24_WEBHOOK_URL=""
BITRIX24_RESPONSIBLE_ID=""

# ── License documents ────────────────────────────────────────────────────────
LICENSOR_LEGAL_NAME=""
LICENSOR_SIGNATURE_IMAGE_PATH=""
